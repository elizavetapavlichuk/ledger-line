# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Postgres connection string. When deploying on Vercel, add the "Postgres"
# storage integration to the project and it fills this in automatically
# (Storage tab -> Create Database -> Postgres). Run `vercel env pull .env.local`
# to bring that same value down for local development.
DATABASE_URL=
